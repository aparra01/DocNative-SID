{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    }
  },
  "DocNative": {
    "OutputRoot": "C:/mnt/PagareOcrEntrada",
    "SalidaRoot": "C:/mnt/PagareOcrSalida",
    "ErrorRoot": "",
    "BlankPageThreshold": 0.02,
    "BlankPageInkRatioThreshold": 0.015,
    "RenderDpi": 300,
    "TesseractExecutablePath": "C:/Program Files/Tesseract-OCR/tesseract.exe",
    "OsdMinConfidence": 0.5,
    "OsdMinConfidenceForRotation": 0.25,
    "OsdMinConfidenceForUpright": 2.0,
    "OsdMinCharactersToTry": 10,
    "OsdMaxEdgePixels": 2000,
    "EnableDocumentRotationConsensus": true,
    "DocumentRotationConsensusMinShare": 0.6,
    "EnableDeskew": true,
    "MaxSkewDegrees": 15,
    "MinSkewDegrees": 0.3,
    "TesseractTimeoutSeconds": 30,
    "FileStabilityMaxWaitSeconds": 20,
    "FileStabilityPollSeconds": 1.5,
    "FileStabilityChecks": 3,
    "PollingIntervalMs": 2000,
    "SinSucursalCode": "SIN_SUCURSAL",
    "EnableInterleavedPdfValidation": true,
    "UsePagareOcrCentralErrorLayout": true,
    "PagareSplitBaseUrl": "http://127.0.0.1:8006",
    "PagareSplitValidationTimeoutSeconds": 120,
    "PagareSplitValidationMaxRetries": 3,
    "PagareSplitValidationRetryDelaySeconds": 2
  }
}
