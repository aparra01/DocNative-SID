# DocNative.Sucursales — contenedor Windows (LTSC 2022) con Tesseract OSD + OpenCvSharp.
FROM mcr.microsoft.com/dotnet/sdk:8.0-windowsservercore-ltsc2022 AS build

WORKDIR C:\\src
COPY . .

RUN dotnet restore src\\DocNative.Sucursales\\DocNative.Sucursales.csproj
RUN dotnet publish src\\DocNative.Sucursales\\DocNative.Sucursales.csproj -c Release -o C:\\app\\publish /p:UseAppHost=true

FROM mcr.microsoft.com/dotnet/aspnet:8.0-windowsservercore-ltsc2022

SHELL ["powershell", "-NoProfile", "-Command"]

# VC++ 2015–2022 x64 (OpenCvSharp runtime).
RUN $ErrorActionPreference = 'Stop'; \
    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; \
    $vc = Join-Path $env:TEMP 'vc_redist.x64.exe'; \
    Invoke-WebRequest -Uri 'https://aka.ms/vs/17/release/vc_redist.x64.exe' -OutFile $vc; \
    $p = Start-Process -FilePath $vc -ArgumentList '/install','/quiet','/norestart' -Wait -PassThru; \
    if ($p.ExitCode -notin 0,3010,1638) { throw \"vc_redist exit $($p.ExitCode)\" }; \
    Remove-Item $vc -Force -ErrorAction SilentlyContinue

# VC++ 2013 x64 + Tesseract (incluye osd.traineddata).
RUN $ErrorActionPreference = 'Stop'; Set-ExecutionPolicy Bypass -Scope Process -Force; \
    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; \
    Invoke-Expression ((New-Object Net.WebClient).DownloadString('https://community.chocolatey.org/install.ps1')); \
    choco install vcredist2013 tesseract -y --no-progress

RUN $ErrorActionPreference = 'Stop'; \
    $tess = 'C:\\Program Files\\Tesseract-OCR\\tesseract.exe'; \
    if (-not (Test-Path $tess)) { throw \"Tesseract no instalado en $tess\" }; \
    & $tess --version

WORKDIR C:\\app

COPY --from=build C:\\app\\publish .

ENV DocNative__TesseractExecutablePath="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"

ENTRYPOINT ["DocNative.Sucursales.exe"]
